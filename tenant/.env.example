# Server
SERVER_PORT=8080
APP_VERSION=1.0.0
GIN_MODE=debug

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenantdb?sslmode=disable

# Auth microservice
AUTH_SERVICE_URL=http://localhost:9090
# Set AUTH_STUB=true to bypass auth service calls during local development
AUTH_STUB=false
# Stub claims used when AUTH_STUB=true (JSON)
AUTH_STUB_USER_ID=00000000-0000-0000-0000-000000000001
AUTH_STUB_ROLE=app_admin
AUTH_STUB_TENANT_ID=
AUTH_STUB_TENANT_SLUG=
AUTH_STUB_EMAIL=admin@platform.internal
